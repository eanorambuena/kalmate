{
  "name": "kalmate",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxi dev",
    "build": "nuxi build",
    "generate": "nuxi generate",
    "preview": "nuxi preview",
    "test": "node --experimental-strip-types --test test/pipeline.test.ts",
    "test:a11y": "lighthouse http://localhost:3000 --output-path=./reports/lighthouse-a11y.html --output=html --only-categories=accessibility --view",
    "test:perf": "lighthouse http://localhost:3000 --output-path=./reports/lighthouse-perf.html --output=html --only-categories=performance,best-practices,seo --view",
    "test:lighthouse": "lighthouse http://localhost:3000 --output-path=./reports/lighthouse.html --output=html --view",
    "postinstall": "nuxi prepare"
  },
  "dependencies": {
    "@lucide/vue": "^1.18.0",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@xenova/transformers": "^2.17.2",
    "lightweight-charts": "^5.2.0",
    "nuxt": "^4.4.7",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "yahoo-finance2": "^3.15.2"
  },
  "pnpm": {
    "minimumReleaseAge": 0,
    "overrides": {
      "tldts-core": "7.4.2",
      "tldts-icann": "7.4.2"
    }
  },
  "devDependencies": {
    "@nuxtjs/tailwindcss": "^6.14.0",
    "lighthouse": "^13.4.0",
    "@oxc-parser/binding-linux-x64-gnu": "0.133.0",
    "@oxc-transform/binding-linux-x64-gnu": "0.133.0",
    "@oxc-minify/binding-linux-x64-gnu": "0.133.0"
  }
}
