# GROQ_API_KEY: Necesaria para el generador de pipelines por IA (Groq Llama 3.3 70B)
# Obtener en https://console.groq.com/keys
GROQ_API_KEY=gsk_tu_api_key_aqui

# Cloudflare: Solo necesarias si deployas con wrangler desde esta máquina
CLOUDFLARE_ACCOUNT_ID=tu_account_id
CLOUDFLARE_API_TOKEN=tu_api_token

# Las siguientes variables son heredadas del proyecto base Emma-HQ.
# Kalmate NO las usa actualmente.
AUTH0_SECRET=dummy
AUTH0_DOMAIN=dummy
AUTH0_CLIENT_ID=dummy
AUTH0_CLIENT_SECRET=dummy
AUTH0_SCOPE=openid
AUTH0_AUDIENCE=dummy
NEXT_PUBLIC_SUPABASE_URL=dummy
NEXT_PRIVATE_SUPABASE_SERVICE_KEY=dummy
NEXT_PUBLIC_SUPABASE_ANON_KEY=dummy
NEXT_STRIPE_SECRET_KEY=sk_test_dummy
NEXT_PUBLIC_APP_URL=https://example.com
